# .env.example

COMPOSE_PROJECT_NAME=oled

# =====================================================
# PORTS
# =====================================================

BACKEND_PORT=8080
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=3000


# =====================================================
# BACKEND
# =====================================================

# Development example:
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional in development.
# Required in production.
BROWSER_WS_TOKEN=

# Format:
# DEVICE_TOKENS=device-id=token
#
# Multiple devices:
# DEVICE_TOKENS=oled-001=token-one,oled-002=token-two
#
# Optional in development.
# Required in production.
DEVICE_TOKENS=


# =====================================================
# FRONTEND
# =====================================================

VITE_WS_URL=ws://localhost:8080
VITE_DEVICE_ID=oled-001